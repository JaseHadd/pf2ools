{
    "compilerOptions": {
        "target": "esnext",
        "outDir": "./dist",
        "removeComments": true,
        "moduleResolution": "bundler",

        "types": ["foundry-pf2e"],

        "jsx": "react",
        "jsxFactory": "JSX.createElement",
        "jsxFragmentFactory": "JSX.Fragment",

        "strict": true,
        "noImplicitReturns": true,

        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
    },
    
    "exclude": [
        "node_modules",
        "dist"
    ],

    "include": [ "src/**/*" ]
}